{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PostgreSql": "Host=postgres;Port=5432;Database=pacs_db;Username=pacs_user;Password=CHANGE_ME_IN_ENV;SSL Mode=Prefer",
    "Redis": "redis:6379"
  },
  "Jwt": {
    "Issuer": "PACS.Api",
    "Audience": "RIS.Frontend",
    "Secret": "CHANGE_ME_USE_ENV_VAR_OR_SECRETS_MANAGER_MIN_32_CHARS",
    "AccessTokenMinutes": 15
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "Dicom": {
    "StoragePath": "/dicom-storage"
  },
  "Serilog": {
    "MinimumLevel": "Information"
  }
}
