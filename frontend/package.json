{
  "name": "yes",
  "version": "1.0.0",
  "private": true,
  "description": "Radiology Information System (RIS) frontend for the Healthcare Imaging Platform",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "eslint.config.js",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",

    "lint": "eslint src",
    "lint:fix": "eslint src --fix",

    "type-check": "tsc -b --noEmit",

    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",

    "audit": "npm audit",
    "audit:fix": "npm audit fix",

    "depcheck": "depcheck",

    "duplicates": "jscpd src",

    "quality": "npm run lint && npm run type-check && npm run test:coverage && npm run build",

    "quality:full": "npm run lint && npm run type-check && npm run test:coverage && npm run build && npm run audit && npm run depcheck && npm run duplicates",

    "sonar": "sonar-scanner"
  },
  "dependencies": {
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.13.5",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@mui/x-data-grid": "^9.2.0",
    "@mui/x-date-pickers": "^9.2.0",
    "@reduxjs/toolkit": "^2.12.0",
    "axios": "^1.18.1",
    "date-fns": "^4.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.18.1",
    "web-vitals": "^4.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "depcheck": "^1.4.7",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jscpd": "^5.0.12",
    "jsdom": "^26.0.0",
    "prettier": "^3.6.2",
    "sonarqube-scanner": "^5.0.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^8.0.9",
    "vitest": "^4.0.0"
  }
}